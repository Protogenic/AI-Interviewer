# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interviewer"

# AI Service base URL
AI_SERVICE_URL="http://localhost:8000"
# Таймаут HTTP к AI (мс): первый ответ LLM/RAG может быть долгим
# AI_SERVICE_TIMEOUT_MS=120000

# Server ports
PORT_REST=3001
PORT_WS=3002

# Frontend origin (для CORS и cookie)
FRONTEND_ORIGIN="http://localhost:5173"

# JWT
# В проде — сгенерировать длинные случайные секреты, например:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# bcrypt
BCRYPT_ROUNDS=10

# Cookie. В проде (HTTPS) — true.
COOKIE_SECURE=false
