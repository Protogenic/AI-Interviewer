{
  "name": "backend-api",
  "version": "0.1.0",
  "description": "Backend API for AI-Interviewer",
  "main": "dist/server.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
